# Supabase — copy this file to .env.local and fill in the values from
# your Supabase project settings (Project Settings → API).

# Public — safe to expose in the browser. Read the project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public — safe to expose in the browser. Used with RLS for anonymous
# reads (e.g. the public /cases page) and to bootstrap the client SDK.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Bypasses RLS entirely. Never prefix with
# NEXT_PUBLIC_, never import from a Client Component, never log it.
# Used only in server-only code (Route Handlers, Server Actions) such
# as the public lead-intake endpoint.
SUPABASE_SERVICE_ROLE_KEY=
